{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-memory",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "OPENROUTER_MODEL": "openai/gpt-5.6-luna"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MEMORY_PROFILE",
        "class_name": "MemoryProfile"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MemoryProfile"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EXTRACT_QUEUE",
        "queue": "agent-memory-extract"
      }
    ],
    "consumers": [
      {
        "queue": "agent-memory-extract",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  }
}
